#!/bin/sh
set -eu
D=/sys/bus/iio/devices/iio:device2
S=/sys/bus/iio/devices/iio_sysfs_trigger
V=/dev/iio:device2
n=0
while [ "$n" -lt 60 ] && { [ ! -r "$D/name" ] || [ ! -e "$V" ]; }; do sleep 1; n=$((n+1)); done
[ "$(cat "$D/name")" = cros-ec-accel ] || exit 1
[ "$(cat "$D/location" 2>/dev/null || true)" = lid ] || exit 1
G=$(getent group iioservice|cut -d: -f3)
[ -n "$G" ] || exit 1
command -v modprobe >/dev/null 2>&1 && modprobe iio_sysfs_trigger 2>/dev/null || true
T=
for f in /sys/bus/iio/devices/trigger*/name; do
 [ -r "$f" ] && [ "$(cat "$f")" = sysfstrig0 ] && T=${f%/name}
done
if [ -z "$T" ] && [ -w "$S/add_trigger" ]; then
 printf '0\n' >"$S/add_trigger"
 n=0
 while [ "$n" -lt 20 ] && [ -z "$T" ]; do
  for f in /sys/bus/iio/devices/trigger*/name; do
   [ -r "$f" ] && [ "$(cat "$f")" = sysfstrig0 ] && T=${f%/name}
  done
  [ -n "$T" ] || { sleep 1; n=$((n+1)); }
 done
fi
[ -n "$T" ] || exit 1
chown root:"$G" "$V"; chmod 660 "$V"
for f in "$D"/* "$D"/buffer/* "$D"/scan_elements/* "$D"/trigger/*; do
 [ -f "$f" ] || continue
 chown :"$G" "$f" 2>/dev/null || true
 chmod g+r "$f" 2>/dev/null || true
done
for f in "$D/buffer/enable" "$D/buffer/length" "$D/trigger/current_trigger" "$D/scan_elements/in_accel_x_en" "$D/scan_elements/in_accel_y_en" "$D/scan_elements/in_accel_z_en" "$D/scan_elements/in_timestamp_en" "$D/sampling_frequency"; do
 [ -e "$f" ] && chmod g+rw "$f" 2>/dev/null || true
done
printf '0\n' >"$D/buffer/enable"
printf '0\n' >"$D/scan_elements/in_timestamp_en"
printf '1\n' >"$D/scan_elements/in_accel_x_en"
printf '1\n' >"$D/scan_elements/in_accel_y_en"
printf '1\n' >"$D/scan_elements/in_accel_y_en"
printf '1\n' >"$D/scan_elements/in_accel_z_en"
printf 'sysfstrig0\n' >"$D/trigger/current_trigger"
printf '1\n' >"$D/buffer/enable"
